{
  "expo": {
    "name": "PitLane UK",
    "slug": "pitlane-uk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "pitlaneuk",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0D10"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uk.co.pitlane.app",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PitLane uses your location to show car meets and events happening near you."
      }
    },
    "android": {
      "package": "uk.co.pitlane.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B0D10",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "_comment": "single, not static: the web map uses Leaflet, which needs a real DOM and cannot be server-rendered. Deep links need a host that rewrites unknown paths to index.html.",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PitLane uses your location to show car meets and events happening near you."
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "PitLane needs access to your photos so you can add a picture to a meet listing.",
          "cameraPermission": "PitLane needs camera access so you can photograph a meet."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
