# Copy this file to .env and fill in the value. .env is git-ignored.
#
# Android Google Maps key. Without it the Map tab is blank grey on Android.
# iOS uses Apple Maps and needs nothing; web uses Leaflet and needs nothing.
#
# Get one at https://console.cloud.google.com:
#   1. Create or pick a project, and enable billing (Maps SDK for Android has
#      a free monthly allowance, but the API will not serve without billing on)
#   2. APIs & Services -> Library -> enable "Maps SDK for Android"
#   3. APIs & Services -> Credentials -> Create credentials -> API key
#   4. Restrict the key: Application restrictions -> Android apps, then add
#      package name uk.co.pitlane.app plus your signing SHA-1 fingerprint
#      (get it with: eas credentials)
#   5. API restrictions -> restrict to "Maps SDK for Android"
#
# An unrestricted key will be scraped from public repos and billed to you.
GOOGLE_MAPS_ANDROID_API_KEY=

# Accounts. Without these the app runs fine but has no sign-in.
# See docs/auth-setup.md for creating the project and the OAuth providers.
#
# The anon key is meant to be public and ships inside the app bundle — what
# protects your data is row-level security on your tables. The service-role
# key is a real secret and must NEVER appear here or anywhere in this app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
